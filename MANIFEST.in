include README.md
include README_zh.md
include LICENSE
include NOTICE
include CITATION.cff
include ARTIFACT.md
include pyproject.toml

recursive-include egvr *.py *.json *.jsonl *.md
recursive-include docs *.md

prune tests
prune logs
prune datasets
prune external_backends
prune private_benchmarks
prune agent_workspace
prune paper
prune build
prune dist

global-exclude .env
global-exclude *.key
global-exclude *.pem
global-exclude *.py[co]
global-exclude __pycache__
global-exclude .pytest_cache
global-exclude .ruff_cache
global-exclude *.ckpt
global-exclude *.pt
global-exclude *.pth
global-exclude *.safetensors
